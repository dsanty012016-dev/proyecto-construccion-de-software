# Copia este archivo como .env.local y completa los valores desde el panel de
# Supabase (Project Settings → API Keys). NUNCA subas .env.local ni claves reales.
# La clave "publishable" (sb_publishable_...) está hecha para ir en el
# navegador; la "secret" no se usa en este proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
